// RoadSTR vendor ABI libraries. These override platform builds only for
// Motorola products importing this namespace.

cc_prebuilt_library_shared {
    name: "android.hardware.audio.core-V2-ndk",
    srcs: ["//vendor/motorola/sm7750-common:roadstr_android_hardware_audio_core_v2_ndk"],
    check_elf_files: false,
    compile_multilib: "64",
    prefer: true,
    sdk_version: "current",
    strip: { none: true },
    vendor_available: true,
}


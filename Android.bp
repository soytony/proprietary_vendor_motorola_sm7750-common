cc_prebuilt_binary {
    name: "C2PAInternetService",
    owner: "motorola",
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/bin/C2PAInternetService",
            ],
            shared_libs: [
                "libavservices_minijail",
                "libjsoncpp",
                "libminksocket_vendor",
                "liblog",
                "libqcbor",
                "libcurl",
                "libutils",
                "libcutils",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    strip: {
        none: true,
    },
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_binary {
    name: "KmInstallKeybox",
    owner: "motorola",
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/bin/KmInstallKeybox",
            ],
            shared_libs: [
                "liblog",
                "libcutils",
                "libcrypto",
                "libkeymasterprovision",
                "libqmi_cci",
                "libqmi_common_so",
                "libkeymasterutils",
                "libkeymasterdeviceutils",
                "libqtikeymaster4",
                "libtpa",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    strip: {
        none: true,

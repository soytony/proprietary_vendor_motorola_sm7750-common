<!--
    Generic empty-SKU vendor manifest fallback for roadstr.

    Keep this file limited to entries that are not already supplied by
    /vendor/etc/vintf/manifest/*.xml fragments. Duplicating fragment HALs makes
    libvintf reject the full device manifest before KeyMint can be discovered.
-->
<manifest version="8.0" type="device" target-level="202404">
    <hal format="aidl">
        <name>android.hardware.biometrics.fingerprint</name>
        <version>3</version>
        <fqname>IFingerprint/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <fqname>IGatekeeper/default</fqname>
    </hal>
    <hal format="aidl" override="true">
        <name>android.hardware.weaver</name>
    </hal>
    <hal format="aidl">
        <name>com.motorola.hardware.biometric.fingerprint</name>
        <version>2</version>
        <fqname>IMotoFingerPrint/default</fqname>
    </hal>
    <hal format="aidl">
        <name>com.motorola.hardware.display.touch</name>
        <version>3</version>
        <fqname>IMotTouch/default</fqname>
    </hal>
    <hal format="aidl">
        <name>com.motorola.hardware.ifaa</name>
        <fqname>IIFAADevice/default</fqname>
    </hal>
    <hal format="aidl">
        <name>motorola.hardware.power</name>
        <version>2</version>
        <fqname>IMdpfExt/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.nxp.nxpnfc_aidl</name>
        <fqname>INxpNfc/default</fqname>
    </hal>
    <hal format="aidl" override="true">
        <name>vendor.qti.hardware.spu</name>
    </hal>
    <sepolicy>
        <version>202404</version>
    </sepolicy>
</manifest>

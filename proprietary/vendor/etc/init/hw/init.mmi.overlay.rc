
# This is for Moto arc device init rc file

import /vendor/etc/init/hw/init.vendor.st21nfc.rc
import /vendor/etc/init/hw/init.mmi.services.override.rc

on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules moto_sched moto_binder

on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -r -d /vendor/lib/modules zram

on late-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules moto_swap

on fs
    insmod /vendor/lib/modules/mmi_annotate.ko
    insmod /vendor/lib/modules/mmi_info.ko
    insmod /vendor/lib/modules/mmi_relay.ko
    insmod /vendor/lib/modules/wl2868c.ko
    insmod /vendor/lib/modules/sensors_class.ko
    insmod /vendor/lib/modules/sx937x_sar.ko
    insmod /vendor/lib/modules/awinic_sar.ko
    insmod /vendor/lib/modules/touchscreen_mmi.ko
    insmod /vendor/lib/modules/goodix_brl_mmi.ko
    insmod /vendor/lib/modules/focaltech_v3_4.ko
    insmod /vendor/lib/modules/mmi_stow.ko
    insmod /vendor/lib/modules/wlan_elna.ko
    insmod /vendor/lib/modules/aw_haptic_hv_v1_5.ko
    #zram wb
    mount_all /vendor/etc/fstab.qcom.zram --early

on post-fs && property:ro.boot.secure_hardware=0
    setprop vendor.wv.oemcrypto.debug.enable_prov40 false

on post-fs
    chmod 0444 /dev/llm_heap
    chown system system /dev/llm_heap
    chown system system /sys/class/misc/llm_heap/drop_caches
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chown system system /sys/class/kgsl/kgsl-3d0/min_pwrlevel
    chown system system /sys/class/kgsl/kgsl-3d0/max_pwrlevel
    chmod 0664 /sys/class/kgsl/kgsl-3d0/min_pwrlevel
    chmod 0664 /sys/class/kgsl/kgsl-3d0/max_pwrlevel
    chown system system /proc/moto_mdpf/is_tgid_sf
    chown system system /proc/moto_mdpf/is_tgid_system_ui
    chown system system /proc/moto_mdpf/mdpf_task
    chmod 0664 /proc/moto_mdpf/is_tgid_sf
    chmod 0664 /proc/moto_mdpf/is_tgid_system_ui
    chmod 0664 /proc/moto_mdpf/mdpf_task
    start vendor.copy_qc_cert
    # allow qcrild to r/w wlan_elna_en
    chown system radio /sys/devices/platform/soc/soc:wlan_elna/wlan_elna_en
    chmod 0664 /sys/devices/platform/soc/soc:wlan_elna/wlan_elna_en

on post-fs-data && property:ro.vendor.build.motfactory=1
    # On the factory build, disallow qcrild to r/w wlan_elna_en and set it to be enabled by default
    chown system system /sys/devices/platform/soc/soc:wlan_elna/wlan_elna_en
    chmod 0644 /sys/devices/platform/soc/soc:wlan_elna/wlan_elna_en
    write /sys/devices/platform/soc/soc:wlan_elna/wlan_elna_en 1

on early-boot
    # Permission for goodix
    chown system system /dev/goodix_fp
    chmod 0664 /dev/goodix_fp
    mkdir /data/vendor/gf_data 0770 system system
    mkdir /mnt/vendor/persist/goodix 0770 system system
    mkdir /data/vendor/fps/ 0770 system system

    chown system system /dev/goodix_fp
    chmod 0664 /dev/goodix_fp
    mkdir /data/vendor/gf_data 0770 system system
    mkdir /mnt/vendor/persist/goodix 0770 system system
    # Permission for jiiov

    chown system system /dev/jiiov_fp
    chmod 0664 /dev/jiiov_fp
    mkdir /data/vendor/jiiov
    chmod 0770 /data/vendor/jiiov
    chown system system /data/vendor/jiiov
    mkdir /data/vendor/jiiov/factory_test
    chmod 0770 /data/vendor/jiiov/factory_test
    chown system system /data/vendor/jiiov/factory_test
    mkdir /mnt/vendor/persist/jiiov 0770 system system
    # are these needed or not
    #mkdir /data/vendor/fingerprint/factory_test
    #chmod 0777 /data/vendor/fingerprint
    #chown system system /data/vendor/fingerprint/factory_test
    #mkdir /data/vendor/fingerprint
    #chmod 0770 /data/vendor/fingerprint
    #chown system system /data/vendor/fingerprint

    # Permission for Health Storage HAL
    chown system system /sys/devices/platform/soc/1d84000.ufshc/ufshid/trigger
    chown system system /sys/devices/platform/soc/1d84000.ufshc/ufshid/color

# Add for after-sales ois gyro cal
    mkdir /mnt/vendor/persist/camera/gyro_compat 0770 vendor_tcmd camera
# Create directory for wireless charge test in factory
    mkdir /data/vendor/wlc 0775 vendor_tcmd system
    chmod 0775  /mnt/vendor/persist/sensors
    chown system system /mnt/vendor/persist/sensors/als_mpc_rawdata
    chmod 0664 /mnt/vendor/persist/sensors/als_mpc_rawdata
    chown system system /mnt/vendor/persist/sensors/als_comp_multi_cal_raw
    chmod 0664 /mnt/vendor/persist/sensors/als_comp_multi_cal_raw
    chmod 0644 /mnt/vendor/persist/sensors/registry/registry/mxm1120_0.json.mxm1120_0_platform.fac_cal
# change permission of backlight brightness for tcmd daemon
    chmod 664 /sys/class/backlight/panel1-backlight/brightness

    # for ghost log capture
    chmod 0444 /dev/tp_tools

    # sys monitor
    mkdir /data/vendor/sys_monitor_temp 0770 system log
    mkdir /data/vendor/sys_monitor_daily 0770 system log
    chown system system /sys/kernel/sys_monitor/cpufreq_count

# wlan subsystem auto recovery from crash
on early-boot
    write /sys/kernel/cnss/recovery 1

on boot
    # allow TCMD to access cci
    chmod 0660 /dev/cci_intf
    chown system camera /dev/cci_intf

    # Touch game mode control
    chown system system /sys/class/touchscreen/primary/rotate
    chmod 0660 /sys/class/touchscreen/primary/rotate
    chown system system /sys/class/touchscreen/primary/interpolation
    chmod 0660 /sys/class/touchscreen/primary/interpolation
    chown system system /sys/class/touchscreen/primary/edge
    chmod 0660 /sys/class/touchscreen/primary/edge
    chown system system /sys/class/touchscreen/primary/sensitivity
    chmod 0660 /sys/class/touchscreen/primary/sensitivity
    chown system system /sys/class/touchscreen/primary/gesture
    chmod 0660 /sys/class/touchscreen/primary/gesture
    chown system system /sys/class/touchscreen/secondary/gesture
    chmod 0660 /sys/class/touchscreen/secondary/gesture
    chown system system /sys/class/touchscreen/primary/sample
    chmod 0660 /sys/class/touchscreen/primary/sample
    chown system system /sys/class/touchscreen/primary/log_trigger
    chmod 0660 /sys/class/touchscreen/primary/log_trigger
    chown system system /sys/class/touchscreen/secondary/stowed
    chmod 0660 /sys/class/touchscreen/secondary/stowed
    chown system system /sys/class/touchscreen/secondary/pocket_mode
    chmod 0660 /sys/class/touchscreen/secondary/pocket_mode

    # change permission for goodix TP
    chmod 0664 /dev/gtp_tools

    #change vibrator test node file access permission
    chmod 0660 /sys/class/qcom-haptics/enable_play
    chown vendor_tcmd system /sys/class/qcom-haptics/enable_play

    #bluetooth sar
    write /data/vendor/radio/bluetooth_sar disable
    chmod 0644 /data/vendor/radio/bluetooth_sar
    chown radio /data/vendor/radio/bluetooth_sar

    # max readyfor apps
    setprop ro.vendor.config.max_readyfor_apps 4

    # vibrator hal need to access this sysfs node for AF noise issue
    chown cameraserver cameraserver /sys/devices/platform/soc/soc:mot,cam-actuator/onekey_actuator
    chmod 0660 /sys/devices/platform/soc/soc:mot,cam-actuator/onekey_actuator

    # CLI touch factory test
    chown vendor_tcmd system /proc/goodix_ts.0/auto_test
    chown vendor_tcmd system /proc/goodix_ts.0/auto_test_result

    # for eSE provisioning
    setprop ro.vendor.oem.device ${ro.product.vendor.device}
    setprop ro.vendor.oem.name ${ro.product.vendor.name}
    setprop ro.vendor.oem.model ${ro.product.vendor.model}
    setprop ro.vendor.oem.brand ${ro.product.vendor.brand}
    setprop ro.vendor.oem.manufacturer ${ro.product.vendor.manufacturer}
    setprop ro.vendor.oem.serialno ${ro.serialno}


    # Use dirty bytes
    write /proc/sys/vm/dirty_background_bytes 26214400
    write /proc/sys/vm/dirty_bytes 104857600

    # Change ownership for capsensor
    chown root input /sys/class/sensors/Moto\ CapSense\ Ch0/enable
    chown root input /sys/class/sensors/Moto\ CapSense\ Ch0/poll_delay
    chown root input /sys/class/sensors/Moto\ CapSense\ Ch1/enable
    chown root input /sys/class/sensors/Moto\ CapSense\ Ch1/poll_delay
    chown root input /sys/class/sensors/Moto\ CapSense\ Ch2/enable
    chown root input /sys/class/sensors/Moto\ CapSense\ Ch2/poll_delay
    chown root input /sys/class/sensors/Moto\ CapSense\ Ch3/enable
    chown root input /sys/class/sensors/Moto\ CapSense\ Ch3/poll_delay
    chown root input /sys/class/sensors/Moto\ CapSense\ Ch4/enable
    chown root input /sys/class/sensors/Moto\ CapSense\ Ch4/poll_delay

    # change permission for capsensor
    chown system system /sys/class/capsense/reset
    chown system system /sys/class/capsense/int_state
    chown radio system /sys/class/capsense/reg
    chown radio system /sys/class/capsense/fw_download_status
    chown system system /sys/class/capsense/mode
    chmod 0660 /sys/class/capsense/reset
    chmod 0660 /sys/class/capsense/int_state
    chmod 0660 /sys/class/capsense/reg
    chmod 0660 /sys/class/capsense/fw_download_status
    chmod 0660 /sys/class/capsense/mode

    #change vibrator gain node file access permission
    chown system system /sys/class/leds/vibrator/gain
    chmod 0660 /sys/class/leds/vibrator/gain
    chown system system /sys/class/leds/vibrator/strength
    chmod 0660 /sys/class/leds/vibrator/strength
    chown system system /sys/class/leds/vibrator/rtp
    chmod 0660 /sys/class/leds/vibrator/rtp
    chown system system /sys/class/leds/vibrator/rtp_interface
    chmod 0660 /sys/class/leds/vibrator/rtp_interface

service vendor.netconfig /vendor/bin/vendor_netconfig
    class main
    user root
    group root system
    oneshot
    disabled

on boot && property:ro.bootmode=mot-factory
    start vendor.netconfig

on property:ro.bootmode=mot-factory
    write /sys/class/leds/charging/brightness 10

service vendor.start_dhrystone /vendor/bin/init.dhrystone.sh -d 300
    class main
    user root
    group root system
    oneshot
    disabled

service vendor.stop_dhrystone /vendor/bin/init.dhrystone.sh -s stop
    class main
    user root
    group root system
    oneshot
    disabled

on early-init && property:ro.boot.speakerid=SSB8E95648
    setprop ro.vendor.audio.acdb_path_cust_extn speaker_lc

on property:persist.vendor.dhrystone.status=0
    start vendor.stop_dhrystone
    start thermal-engine

service vendor.mot_vsync_psd /vendor/bin/mot_vsync_psd
    class late_start
    user root

service vendor.capsense_reset /vendor/bin/capsense_reset
   class core
   user system
   group system input
   disabled

on property:persist.vendor.dhrystone.status=1
    stop thermal-engine
    start vendor.start_dhrystone

service vendor.copy_qc_cert /vendor/bin/copy_qc_cert.sh
    class main
    user system
    group root system
    oneshot
    disabled

service vendor.mmi-cap-sh /vendor/bin/init.mmi.cap.sh
    class core
    user root
    oneshot

service vendor.mmi-wls-sh /vendor/bin/init.mmi.wls.sh
    class main
    user root
    group root system
    oneshot
    disabled

service vendor.ultrasound_cal /vendor/bin/ultrasound_cal.sh -c
    class main
    user root
    group system
    oneshot
    disabled

service vendor.disable_stm /vendor/bin/sh /vendor/bin/init.moto.kernel.debug-roadstr.sh
    class late_start
    user root
    group system
    oneshot
    seclabel u:r:vendor-qti-testscripts:s0
    disabled

on property:vendor.ultrasound.cal.action=start
    start vendor.ultrasound_cal

on property:sys.boot_completed=1
    start vendor.capsense_reset
    #change adsp pmic test command file access permission
    chown vendor_tcmd system /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/tcmd
    chown vendor_tcmd system /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/force_pmic_icl
    chown vendor_tcmd system /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/force_usb_suspend
    chown vendor_tcmd system /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/force_wls_en
    chown vendor_tcmd system /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/force_wls_curr_max
    chown vendor_tcmd system /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/force_wls_volt_max
    chown vendor_tcmd system /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/addr
    chown vendor_tcmd system /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/data
    chown vendor_tcmd system /sys/module/bm_adsp_ulog/parameters/debug_enabled
    chown vendor_tcmd system /sys/module/mmi_glink_charger/parameters/factory_kill_disable
    chown vendor_tcmd system /sys/class/power_supply/wireless/voltage_now
    chown vendor_tcmd system /sys/class/power_supply/wireless/current_now
    chown vendor_tcmd system /sys/class/qcom-battery/wireless_fw_version
    chmod 0660 /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/tcmd
    chmod 0660 /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/force_pmic_icl
    chmod 0660 /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/force_usb_suspend
    chmod 0660 /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/force_wls_en
    chmod 0660 /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/force_wls_curr_max
    chmod 0660 /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/force_wls_volt_max
    chmod 0660 /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/addr
    chmod 0660 /sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:mmi,qti-glink-charger/data
    chmod 0660 /sys/module/bm_adsp_ulog/parameters/debug_enabled
    chmod 0660 /sys/module/mmi_glink_charger/parameters/factory_kill_disable
    chmod 0660  /sys/class/power_supply/wireless/voltage_now
    chmod 0660  /sys/class/power_supply/wireless/current_now
    chmod 0660  /sys/class/qcom-battery/wireless_fw_version
    # start wireless chip firmware upgrate
    start vendor.mmi-wls-sh
    #change flip battery charging test command file access permission
    wait /sys/class/power_supply/balance_slave/balance_chip_en 2
    chown vendor_tcmd system /sys/class/power_supply/balance_slave/balance_chip_en
    chown vendor_tcmd system /sys/class/power_supply/balance_slave/balance_chrg_dis
    chown vendor_tcmd system /sys/class/power_supply/balance_slave/input_current_limit

    # Change force_charging_enable access mode and permission for tcmd
    wait /sys/class/power_supply/battery/device/force_charging_enable 2
    chmod 0664 /sys/class/power_supply/battery/device/force_charging_enable
    chown vendor_tcmd system /sys/class/power_supply/battery/device/force_charging_enable

    # Set adaptive charging perms for HAL
    chown system system /sys/module/qpnp_adaptive_charge/parameters/upper_limit
    chown system system /sys/module/qpnp_adaptive_charge/parameters/lower_limit

    # Set gyro.fac_cal.bias perms for camera
    chmod 0666 /mnt/vendor/persist/sensors/registry/registry/icm456xx_0.json.icm456xx_0_platform.gyro.fac_cal.bias

    copy /vendor/etc/qms_log_config /data/vendor/qms_logs/config/qms_log_config
    chown radio radio /data/vendor/qms_logs/config/qms_log_config
    chmod 0700 /data/vendor/qms_logs/config/qms_log_config

    #set game quick touch feature enable
    setprop debug.vendor.perf.smart_touch 1

    write /sys/module/mm_tune/parameters/cma_bypass 0

#Override fwpath string when wpa_supplicant server was killed
on property:vendor.wifi.station=true
    write /sys/module/qca_cld3_qca6750/parameters/sar_sta enabled

on property:vendor.wifi.station=false
    write /sys/module/qca_cld3_qca6750/parameters/sar_sta disabled

on property:vendor.wifi.tethering=false
    write /sys/module/qca_cld3_qca6750/parameters/sar_mhs disabled

on property:vendor.wifi.tethering=true
    write /sys/module/qca_cld3_qca6750/parameters/sar_mhs enabled

on property:persist.mot_bt.sar_state=connect
    write /data/vendor/radio/bluetooth_sar connect

on property:persist.mot_bt.sar_state=disconnect
    write /data/vendor/radio/bluetooth_sar disconnect

#update the high watermark by set efk value
on property:vendor.post_boot.parsed=1
    setprop sys.sysctl.extra_free_kbytes ${sys.sysctl.extra_free_kbytes}

on property:vendor.usb.headset_reset=2
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode none

on property:vendor.usb.headset_reset=0
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/headset_reset_delay 2
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode host

on property:sys.usb.current_limit=1
    write /sys/class/power_supply/battery/device/force_charger_suspend 1

on property:sys.usb.current_limit=0
   write /sys/class/power_supply/battery/device/force_charger_suspend 0

# dynamic update vsync property
on property:sys.display.pluggable_vsync_prioritized=1
    setprop vendor.display.pluggable_vsync_prioritized 1

on property:sys.display.pluggable_vsync_prioritized=0
    setprop vendor.display.pluggable_vsync_prioritized 0

on boot && property:ro.product.is_production=false
    # Start mmi_watchdog for stability
    start vendor.mmi_watchdogd

on property:sys.boot_completed=1
    wait /sys/class/drm/card0-DSI-1/panelPcdCheck
    chmod 0666 /sys/class/drm/card0-DSI-1/panelPcdCheck

# load moto kern prot, must be after the wifi driver maps DMA!
on property:sys.boot_completed=1 && property:ro.boot.moto_kern_prot=true
    insmod /vendor/lib/modules/moto_kern_prot.ko mem_ready=1

on property:sys.boot_completed=1 && property:ro.product.is_production=false
    insmod /vendor/lib/modules/moto_pm_vh.ko
    setprop vendor.moto_pm_vh_installed true
    write /sys/power/pm_freeze_timeout 5000
    #set game quick touch log on
    setprop debug.vendor.perf.smart_touch.trace 1

on property:sys.boot_completed=1 && property:ro.boot.enable_moto_pm_vh=1 && property:ro.product.is_production=true
    insmod /vendor/lib/modules/moto_pm_vh.ko
    setprop vendor.moto_pm_vh_installed true

on property:vendor.moto_pm_vh_installed=true && property:ro.boot.freeze_panic_mode=panic
    write /proc/driver/moto_pm_vh "panic"

on property:vendor.moto_pm_vh_installed=true && property:ro.boot.freeze_timeout=*
    write /sys/power/pm_freeze_timeout ${ro.boot.freeze_timeout}

on init && property:ro.bootmode=mot-factory
    write /sys/bus/platform/devices/c42d000.qcom,spmi:qcom,pmiv0108@7:eusb2-repeater@fd00/user_host_param_override "0x00,0x51,0x07,0x53"
    write /sys/bus/platform/devices/c42d000.qcom,spmi:qcom,pmiv0108@7:eusb2-repeater@fd00/user_param_override "0x0a,0x51,0x05,0x57"

on property:sys.boot_completed=1 && property:ro.boot.ftrace_on=1 && property:ro.boot.ftrace_buf_size=*
    write /sys/kernel/tracing/tracing_on 0
    write /sys/kernel/tracing/set_event ""
    write /sys/kernel/tracing/trace ""
    write /sys/kernel/tracing/buffer_size_kb ${ro.boot.ftrace_buf_size}
    write /sys/kernel/tracing/events/rwmmio/enable 1

    # sched
    write /sys/kernel/tracing/events/sched/sched_switch/enable 1
    write /sys/kernel/tracing/events/sched/sched_enq_deq_task/enable 1
    write /sys/kernel/tracing/events/sched/sched_migrate_task/enable 1
    write /sys/kernel/tracing/events/sched/sched_wakeup/enable 1
    write /sys/kernel/tracing/events/sched/sched_wakeup_new/enable 1

    # irq
    write /sys/kernel/tracing/events/irq/enable 1
    # timer
    write /sys/kernel/tracing/events/timer/enable 1
    # hot-plug
    write /sys/kernel/tracing/tracing_on 1

on property:sys.boot_completed=1 && property:ro.build.type=userdebug
    write /sys/kernel/tracing/tracing_on 0
    start vendor.disable_stm

on property:sys.boot_completed=1 && property:ro.boot.cid=0x0000
    start vendor.sys_monitor

# For Android Auto connected
on property:sys.android.auto.connect=1
    write /sys/class/power_supply/battery/android_auto_mode 1

# For Android Auto disconnected
on property:sys.android.auto.connect=0
    write /sys/class/power_supply/battery/android_auto_mode 0

service vendor.sys_monitor /vendor/bin/sys_monitor
    class late_start
    user system
    group system log diag
    oneshot
    disabled


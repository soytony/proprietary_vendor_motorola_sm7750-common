service vendor.keymint-strongbox /vendor/bin/hw/android.hardware.security.keymint-service.strongbox-thales
    class early_hal
    user vendor_thales_strongbox
    group vendor_thales_strongbox
    disabled

# VHW reports ese_st only for StrongBox-capable dnes/nes SKUs. Keep factory
# controls scoped to those variants instead of the blocked ro.boot export.
on property:sys.bootbroadcast_completed=1 && property:ro.vendor.build.motfactory=1 && property:ro.bootmode=mot-factory && property:ro.vendor.hw.nfc=ese_st
    stop vendor.keymint-strongbox

on property:vendor.tcmd.ese.strongbox.disable=1 && property:ro.bootmode=mot-factory && property:ro.vendor.hw.nfc=ese_st
    stop vendor.keymint-strongbox

on property:vendor.tcmd.ese.strongbox.disable=0 && property:ro.bootmode=mot-factory && property:ro.vendor.hw.nfc=ese_st
    start vendor.keymint-strongbox

# Current platform owns ro.boot.* and rejects VHW's runtime export. Use VHW's
# underlying eSE hardware result so StrongBox starts only on capable SKUs.
on init && property:ro.vendor.hw.nfc=ese_st
    start vendor.keymint-strongbox

# Restart the complete eSE security stack only when StrongBox hardware exists.
on property:vendor.ese.client.restart=1 && property:ro.vendor.hw.nfc=ese_st
    stop vendor.secure_element
    stop vendor.keymint-strongbox
    stop keystore2
    stop weaver_hal_service
    start keystore2
    start vendor.keymint-strongbox
    start vendor.secure_element
    start weaver_hal_service
    setprop vendor.ese.client.restart 0

on property:vendor.ese.client.restart=1 && property:ro.boot.strongbox_support=false
    stop vendor.secure_element
    stop keystore2
    start keystore2
    start vendor.secure_element
    setprop vendor.ese.client.restart 0

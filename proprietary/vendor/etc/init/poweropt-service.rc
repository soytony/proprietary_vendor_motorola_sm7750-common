#  @file    poweropt-servce.rc
#  @brief   Definition to enable poweropt
#
#  DESCRIPTION
#  ---------------------------------------------------------------------------
#       Copyright (c) 2020-2022 Qualcomm Technologies, Inc.
#       All Rights Reserved.
#       Confidential and Proprietary - Qualcomm Technologies, Inc.
#  ---------------------------------------------------------------------------
service poweropt-service /vendor/bin/poweropt-service
    class hal
    user system
    group system readproc input
    # Refreshed PowerOpt blobs crash in PowerOptXMLParser every five seconds,
    # eventually blocking ActivityManager and forcing system_server restarts.
    # Lineage's primary power HAL remains active; keep this optional module off.
    disabled

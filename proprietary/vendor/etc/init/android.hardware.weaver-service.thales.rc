service weaver_hal_service /vendor/bin/hw/android.hardware.weaver-service.thales
    class hal
    user  vendor_thales_weaver
    group vendor_thales_weaver
    disabled

# Current platform owns ro.boot.* and rejects VHW's runtime export. Use VHW's
# underlying eSE hardware result so Weaver starts only on StrongBox-capable SKUs.
on init && property:ro.vendor.hw.nfc=ese_st
    start weaver_hal_service

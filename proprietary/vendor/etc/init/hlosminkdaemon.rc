# Start daemon before vdc keymaster earlyBootEnded can block post-fs-data
on post-fs-data
    start vendor.minkdaemon

# Start daemon on early-init
on early-boot
    start vendor.minkdaemon

service vendor.minkdaemon /vendor/bin/hlosminkdaemon
    class late_start
    user system
    group system
    disabled
    oneshot
    socket hlos_mink_opener stream 0660 system system

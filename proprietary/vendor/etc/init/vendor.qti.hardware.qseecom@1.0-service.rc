on property:vendor.roadstr.secure_stack.ready=1
    start qseecom-service

service qseecom-service /vendor/bin/hw/vendor.qti.hardware.qseecom@1.0-service
    class hal
    user system
    group system drmrpc
    interface aidl vendor.qti.hardware.qseecom
    disabled
